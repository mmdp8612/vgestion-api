APP_NAME=VisualGestion
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://api.example.com
APP_BIND_IP=127.0.0.1
APP_PORT=8080
APP_TIMEZONE=America/Argentina/Buenos_Aires
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_AR

LOG_CHANNEL=stderr
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=host.docker.internal
DB_PORT=3306
DB_DATABASE=vgestion-api-2
DB_USERNAME=visualgestion_api
DB_PASSWORD=

CACHE_STORE=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_TIMEOUT=10
MAIL_EHLO_DOMAIN=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=VisualGestion

API_TOKEN_TTL=86400
API_SUPER_BROKER=Z999
PROPERTY_IMAGE_LIMIT=5
PROPERTY_IMAGE_BASE_URL=https://www.pfdatos.com.ar/visualgestion/usuario/zsistema/imagenes

# Use * únicamente cuando el puerto esté detrás de un proxy inverso confiable.
TRUSTED_PROXIES=*
